\f0\fs24 \cf0 <Window xmlns="https://github.com/avaloniaui"\
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"\
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"\
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"\
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="250"\
        x:Class="XPathEditor.MainWindow"\
        Title="XPath Editor (Basic Version)">\
\
    <Grid Margin="10"\
          RowDefinitions="Auto,Auto,10,*">\
\
        <!-- XML File -->\
        <Grid Grid.Row="0"\
              ColumnDefinitions="90,*,35"\
              ColumnSpacing="5">\
\
            <TextBlock Text="XML File Path"\
                       VerticalAlignment="Center"/>\
\
            <TextBox x:Name="txtXmlFile"\
                     Grid.Column="1"/>\
\
            <Button Grid.Column="2"\
                    Content="..."\
                    Click="OpenXml_Click"/>\
        </Grid>\
\
        <!-- XPath -->\
        <Grid Grid.Row="1"\
              Margin="0,8,0,0"\
              ColumnDefinitions="90,*,80"\
              ColumnSpacing="5">\
\
            <TextBlock Text="XPath Expression"\
                       VerticalAlignment="Center"/>\
\
            <TextBox x:Name="txtXPath"\
                     PlaceholderText="write the xpath expression here. e.g /dei/course/@name"\
                     Grid.Column="1"/>\
\
            <Button Grid.Column="2"\
                    Content="Execute"\
                    Click="Execute_Click"/>\
        </Grid>\
\
        <!-- Results -->\
        <ScrollViewer Grid.Row="3"\
                      HorizontalScrollBarVisibility="Auto"\
                      VerticalScrollBarVisibility="Auto">\
\
            <TextBox x:Name="txtResults"\
                     AcceptsReturn="True"\
                     TextWrapping="Wrap"\
                     IsReadOnly="True" />\
\
        </ScrollViewer>\
    </Grid>\
</Window>}