 <Window xmlns="https://github.com/avaloniaui" 
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" 
x:Class="ProductsClientApp.MainWindow" 
Width="600" 
SizeToContent="Height" 
Title="RESTful Client Application - Products"> 
<Grid Margin="15"> 
<Grid.ColumnDefinitions> 
<ColumnDefinition Width="2*" /> 
<ColumnDefinition Width="*" /> 
</Grid.ColumnDefinitions> 
<Grid.RowDefinitions> 
<RowDefinition Height="Auto"/> 
<RowDefinition Height="250"/> 
<RowDefinition Height="Auto"/> 
<RowDefinition Height="150"/> 
<RowDefinition Height="Auto"/> <!-- Status --> 
</Grid.RowDefinitions> 
<!-- Get All --> 
<Button 
Grid.Row="0" 
Grid.Column="0" 
Name="btnGetAll" 
Content="Get All Products" 
Width="160" 
Background="#2E7D32"
Foreground="White" 
HorizontalAlignment="Left" 
Click="GetAll_Click"/> 
<!-- List of Products --> 
<ListBox 
Grid.Row="1" 
Grid.Column="0" 
Name="lstProducts" 
Margin="0,10,10,10"/> 
<!-- Get Specific Product --> 
<StackPanel 
Grid.Row="2" 
Grid.Column="0" 
Orientation="Horizontal"> 
<Button 
Name="btnGet" 
Content="Get Product (?)" 
Click="BtnGetSpecific_Click"/> 
<TextBox 
Name="txtSearchId" 
PlaceholderText="Id do produto" 
Width="120" 
Margin="10,0,0,0"/> 
</StackPanel> 
<!-- Result --> 
<TextBox 
Grid.Row="3" 
Grid.Column="0" 
Name="txtResult" 
Margin="0,10,10,0" 
AcceptsReturn="True" 
FontFamily="Consolas,Menlo,monospace" 
TextWrapping="Wrap"/> 
<!-- Right side --> 
<StackPanel 
Grid.Row="1" 
Grid.Column="1" 
Margin="20,10,0,0"> 
<TextBlock Text="Id"/> 
<TextBox Name="txtId" Background="AliceBlue"/> 
<TextBlock Text="Name" Margin="0,10,0,0"/> 
<TextBox Name="txtName"/> 
<TextBlock Text="Category" Margin="0,10,0,0"/> 
<TextBox Name="txtCategory"/> 
<TextBlock Text="Price" Margin="0,10,0,0"/> 
<TextBox Name="txtPrice"/> 
<Button 
Name="btnPost" 
Margin="0,20,0,0" 
Content="POST (Create)" 
Click="BtnCreate_Click"/> 
<Button 
Name="btnPut" 
Margin="0,10,0,0" 
Content="PUT (Update)" 
Click="BtnGetUpdate_Click"/> 
<Button 
Name="btnDelete" 
Margin="0,10,0,0" 
Content="DEL (Delete)" 
Click="BtnDelete_Click"/>
</StackPanel> 
<Border Grid.Row="4" 
Grid.ColumnSpan="2" 
Padding="5"> 
<TextBlock Name="txtStatus" 
VerticalAlignment="Center"/> 
</Border> 
</Grid> 
</Window> 